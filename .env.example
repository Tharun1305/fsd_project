# Google Cloud / Firebase Firestore Configuration
# Option 1: File path to your downloaded Service Account Key JSON
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Option 2: Full JSON string for cloud deployment (e.g. on Google Cloud Run or Vercel)
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'

# Groq AI Chatbot API Key
GROQ_API_KEY=""

# Server Port (default 5000)
PORT=5000
