# ============================================================
# G V Clothings B2B Backend — Environment Variables Template
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env or serviceAccountKey.json to Git.
# ============================================================

# ── Firebase / Firestore (Backend) ──────────────────────────
# Option A: Local development — path to your downloaded service account JSON
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Option B: Cloud deployment (Render, Railway, etc.) — paste the full JSON string
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"gv-clothings-tirupur",...}'

# ── Groq AI Chatbot API Key ──────────────────────────────────
GROQ_API_KEY=""

# ── Server Port ──────────────────────────────────────────────
PORT=5000

# ── CORS Allowed Origins (optional) ─────────────────────────
# Comma-separated list of frontend URLs. Leave empty to allow all origins.
# Example: ALLOWED_ORIGINS=https://gv-clothings.web.app,https://gv-clothings.firebaseapp.com
ALLOWED_ORIGINS=""

# ============================================================
# Frontend (Vite) Environment Variables
# ============================================================
# Create a separate .env file in the project root for Vite.
# All VITE_ prefixed vars are bundled into the frontend build.
#
# VITE_API_URL — points the frontend to the deployed backend API.
#   • Local dev: leave UNSET (Vite proxy handles /api → localhost:5000)
#   • Deployed frontend: set to your full Render backend URL, e.g.:
#     VITE_API_URL=https://gv-clothings-backend.onrender.com
#
# VITE_GROQ_API_KEY — only needed for the chatbot's client-side fallback
#   (optional; the backend /api/chat endpoint is the primary path)
# VITE_GROQ_API_KEY=""
