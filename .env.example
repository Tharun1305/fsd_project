# ========================================================
# FRONTEND CONFIGURATION
# ========================================================
# Base URL for the backend API.
# Anyone who clones the repo and runs the frontend locally will automatically
# connect to the deployed Render backend API by default.
VITE_API_URL=https://gv-clothings-backend.onrender.com

# For local backend development, switch to localhost:
# VITE_API_URL=http://localhost:5000

# Optional: Groq AI Client Key (if using client-side fallback)
# VITE_GROQ_API_KEY=""

# ========================================================
# BACKEND SECRETS (Deployed on Render / Cloud)
# WARNING: NEVER EXPOSE FIREBASE SERVICE ACCOUNT IN FRONTEND OR GITHUB
# ========================================================
# On Render (Service Settings -> Environment -> Add Environment Variable):
# Option 1 (Recommended for Render): Raw JSON string or Base64 string of serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"gv-clothings-tirupur",...}'

# Option 2: Local file path when running backend locally (serviceAccountKey.json in root)
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Groq AI Chatbot API Key (Backend Secret)
GROQ_API_KEY=""

# Server Port (Render automatically sets PORT)
PORT=5000
